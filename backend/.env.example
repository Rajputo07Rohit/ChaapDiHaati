PORT=4000
NODE_ENV=development
DATABASE_PATH=./data/chaapdihaati.db
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:5173
BCRYPT_SALT_ROUNDS=10

# --- Customer self-order phone verification (2Factor.in SMS OTP) ---
# From your 2Factor.in account. Leave unset until that's configured —
# send-otp/requireCustomerAuth report a clear config error instead of the
# app failing to boot.
# TWOFACTOR_API_KEY=

# --- Railway production values (set these in the Railway dashboard, not here) ---
# PORT is set automatically by Railway — don't hardcode it.
# NODE_ENV=production
# DATABASE_PATH=/data/chaapdihaati.db   <- must point inside the mounted Volume, or the DB is wiped on every redeploy
# JWT_SECRET=<generate with: openssl rand -hex 32>
# CORS_ORIGIN=https://your-site.netlify.app   <- fallback only; Netlify's proxy redirect makes this same-origin so it's not load-bearing

# Cashfree Payments (UPI/cards/netbanking). Use sandbox keys for testing.
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# CASHFREE_ENV=sandbox   # "production" only with live keys

# Cashfree webhook (set in Cashfree dashboard → Developers → Webhooks, for
# Payment and Refund events, API version 2023-08-01):
#   https://<your-backend>/api/public/payments/cashfree/webhook
# It's verified with CASHFREE_SECRET_KEY — no separate secret needed. Even
# without it, a background job reconciles payments every minute.

# --- Customer notifications (all optional; each is skipped while unset) ---
# Browser push. Generate a pair with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
#
# WhatsApp Business Cloud API (Meta). Needs an approved template named
# WHATSAPP_TEMPLATE_NAME with 3 body variables, e.g.:
#   "Hi {{1}}, update on your Desi Chaap Di Hatti order {{2}}: {{3}}"
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=order_update
# WHATSAPP_TEMPLATE_LANG=en

# Public URL of the customer app (used in notification links)
# CUSTOMER_APP_URL=https://order.example.com

# --- Error monitoring (optional) ---
# SENTRY_DSN=
