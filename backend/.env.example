PORT=4000
NODE_ENV=development
DATABASE_PATH=./data/chaapdihaati.db
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:5173
BCRYPT_SALT_ROUNDS=10

# --- Customer self-order phone verification (2Factor.in SMS OTP) ---
# From your 2Factor.in account. Leave unset until that's configured —
# send-otp/requireCustomerAuth report a clear config error instead of the
# app failing to boot.
# TWOFACTOR_API_KEY=

# --- Customer self-order online payment (Razorpay, test mode) ---
# From your Razorpay dashboard (Test Mode keys). Leave unset until that's
# configured — the Razorpay checkout button is skipped on the customer app.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# --- Railway production values (set these in the Railway dashboard, not here) ---
# PORT is set automatically by Railway — don't hardcode it.
# NODE_ENV=production
# DATABASE_PATH=/data/chaapdihaati.db   <- must point inside the mounted Volume, or the DB is wiped on every redeploy
# JWT_SECRET=<generate with: openssl rand -hex 32>
# CORS_ORIGIN=https://your-site.netlify.app   <- fallback only; Netlify's proxy redirect makes this same-origin so it's not load-bearing
